# このファイルを .env にコピーして値を入れてください（.env は Git に含まれません）
# ANTHROPIC_API_KEY が空ならモックモードで動きます
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# 類似度の閾値（0〜1）。これ未満の過去回答は根拠に使わない
SIMILARITY_THRESHOLD=0.30

# 費用の試算（未設定なら src/cost.ts の料金表と 150円/USD を使用）
# PRICE_INPUT_PER_MTOK=2
# PRICE_OUTPUT_PER_MTOK=10
# USD_JPY=150

# ai-usage-guardrail を使う場合はアダプターのパスを指定（未設定なら内蔵の簡易マスキング）
# AI_USAGE_GUARDRAIL_MODULE=adapters/ai-usage-guardrail.mjs
